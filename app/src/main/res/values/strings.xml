    <!-- Onboarding How it works cards (Section 5) -->
    <string name="how_it_works_title">How it works</string>
    <string name="onboarding_name_subtitle">Used only for sentences that mention your name.</string>
    <string name="how_card_1">Read it slowly, once or twice. Say it out loud if you can.</string>
    <string name="how_card_2">Ask yourself if it feels true. \"Not yet\" is a fine answer.</string>
    <string name="how_card_3">Do the small step under the sentence. That is the whole practice. About 2 minutes.</string>

    <!-- Six Reading Rules (Section 3.4 & Section 5) -->
    <string name="rule_1">Read slowly, once or twice. Do not repeat it many times.</string>
    <string name="rule_2">Notice if it feels true. \"Not yet\" is a fine answer.</string>
    <string name="rule_3">If it does not feel true, think of a time it was true and a time it was not.</string>
    <string name="rule_4">Do the small step under the sentence. It matters more than the sentence.</string>
    <string name="rule_5">Stop after one to three sentences. One session a day is enough.</string>
    <string name="rule_6">If something makes you feel worse, stop. Try another category or take a break.</string>

